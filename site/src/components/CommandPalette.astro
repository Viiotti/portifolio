---
import { href, nav, person } from '../lib/site';

const commands = [
  { label: 'Home', hint: 'page', action: 'go', value: href('/') },
  ...nav.map((n) => ({ label: n.label, hint: 'page', action: 'go', value: href(n.path) })),
  { label: 'Contact — hiring for a role', hint: 'page', action: 'go', value: href('/hire/') },
  { label: 'Contact — I have a project', hint: 'page', action: 'go', value: href('/hire/?type=project') },
  { label: 'Privacy', hint: 'page', action: 'go', value: href('/privacy/') },
  { label: 'Copy email address', hint: person.email, action: 'copy', value: person.email },
  { label: 'Switch theme', hint: 'light / dark', action: 'theme', value: '' },
  { label: 'GitHub', hint: 'external', action: 'go', value: person.github },
  { label: 'LinkedIn', hint: 'external', action: 'go', value: person.linkedin },
];
---

<dialog class="palette no-print" aria-label="Command menu" data-palette>
  <div class="palette__box">
    <label class="sr-only" for="palette-input">Type a command or a page</label>
    <input id="palette-input" class="palette__input" type="text" autocomplete="off" spellcheck="false"
      placeholder="Type a command or a page…" role="combobox" aria-expanded="true"
      aria-controls="palette-list" aria-autocomplete="list" />
    <ul id="palette-list" class="palette__list" role="listbox" aria-label="Commands">
      {commands.map((c, i) => (
        <li id={`palette-opt-${i}`} role="option" aria-selected="false" class="palette__item"
          data-action={c.action} data-value={c.value} data-label={c.label.toLowerCase()}>
          <span>{c.label}</span><span class="mono palette__hint">{c.hint}</span>
        </li>
      ))}
    </ul>
    <p class="palette__status mono" role="status" aria-live="polite"></p>
    <p class="palette__foot mono"><span>↑↓ move</span><span>↵ open</span><span>esc close</span></p>
  </div>
</dialog>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .palette { padding: 0; border: 0; background: transparent; width: min(560px, calc(100vw - 32px)); margin: 12vh auto auto; color: var(--ink); }
  .palette::backdrop { background: rgba(4, 6, 9, 0.6); backdrop-filter: blur(2px); }
  .palette__box { background: var(--bg-raised); border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.6); }
  .palette__input { width: 100%; height: 56px; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); font: 16px var(--sans); padding: 0 18px; outline: none; }
  .palette__list { list-style: none; max-height: 340px; overflow-y: auto; padding: 6px; }
  .palette__item { display: flex; justify-content: space-between; gap: 16px; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 8px; cursor: pointer; font-size: 14px; }
  .palette__item[aria-selected='true'] { background: var(--accent-soft); color: var(--ink); box-shadow: inset 2px 0 0 var(--accent); }
  .palette__item[hidden] { display: none; }
  .palette__hint { font-size: 11.5px; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .palette__status { font-size: 12px; color: var(--accent); padding: 0 18px; min-height: 0; }
  .palette__status:not(:empty) { padding: 8px 18px; }
  .palette__foot { display: flex; gap: 16px; font-size: 11px; color: var(--ink-3); padding: 10px 18px; border-top: 1px solid var(--line); }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('input')!;
  const status = dialog.querySelector<HTMLElement>('.palette__status')!;
  const items = [...dialog.querySelectorAll<HTMLLIElement>('[role="option"]')];
  let active = 0;

  const visible = () => items.filter((i) => !i.hidden);
  const highlight = (index: number) => {
    const list = visible();
    if (!list.length) { input.removeAttribute('aria-activedescendant'); return; }
    active = (index + list.length) % list.length;
    items.forEach((i) => i.setAttribute('aria-selected', 'false'));
    list[active].setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', list[active].id);
    list[active].scrollIntoView({ block: 'nearest' });
  };
  const filter = () => {
    const q = input.value.trim().toLowerCase();
    items.forEach((i) => { i.hidden = !!q && !(i.dataset.label ?? '').includes(q); });
    highlight(0);
  };
  const open = () => {
    if (dialog.open) return;
    input.value = '';
    status.textContent = '';
    filter();
    dialog.showModal();
    input.focus();
  };
  const run = async (item: HTMLLIElement | undefined) => {
    if (!item) return;
    const { action, value = '' } = item.dataset;
    if (action === 'go') { dialog.close(); location.href = value; }
    else if (action === 'theme') { dialog.close(); document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click(); }
    else if (action === 'copy') {
      try { await navigator.clipboard.writeText(value); status.textContent = 'Copied to the clipboard.'; }
      catch { status.textContent = value; }
    }
  };

  document.querySelectorAll('[data-palette-open]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dialog.open ? dialog.close() : open(); }
  });
  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); highlight(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(active - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); run(visible()[active]); }
  });
  items.forEach((item) => {
    item.addEventListener('click', () => run(item));
    item.addEventListener('pointermove', () => highlight(visible().indexOf(item)));
  });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>
