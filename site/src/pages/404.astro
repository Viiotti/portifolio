---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
---

<Base title="Page not found" path="/404/" noindex description="This page does not exist.">
  <div class="wrap nf">
    <p class="mono nf__code">404</p>
    <h1>This page does not exist, or it moved.</h1>
    <p class="muted">Try the command menu (⌘K or Ctrl+K), or go back home.</p>
    <a class="btn btn--primary" href={href('/')}>Back to the home page</a>
  </div>
</Base>

<style>
  .nf { min-height: 60vh; display: grid; place-content: center; justify-items: center; gap: 16px; text-align: center; padding-top: 48px; padding-bottom: 48px; }
  .nf__code { font-size: clamp(64px, 16vw, 120px); line-height: 1; color: var(--accent); letter-spacing: -0.05em; }
  .nf h1 { font-size: clamp(22px, 3vw, 28px); }
</style>
